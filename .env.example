# Copy to .env and fill in. All keys optional; anything missing falls back to ../cemig-ext-data/.env.
ACCOUNT=                # SanPlat account for the MDC login
SANPLAT_PASSWORD=       # its encrypted password (24-char base64, same format cemig-ext-data uses)
MONGO_URI=              # e.g. mongodb://host:27017/ami?directConnection=true
MONGO_USER=
MONGO_PASS=
MONGO_AUTH_SOURCE=
AUDIT_SSH_PASS=         # SSH password for --tunnel / --ssh-scan if different from cemig-ext-data
